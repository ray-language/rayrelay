// rayrelay — rendezvous + blind relay for takeit and msg.
import std/time;
import std/process;
import relay;
import auth;
import stun;
import client;
from net/log import logger, info, warn, field, field_int, emit;

const DEFAULT_PORT: int = 7440;

const DEFAULT_STUN_PORT: int = 7441;

const DEFAULT_IDLE_SECS: int = 300;

fn usage() {
    eprint("usage:");
    eprint("  rayrelay serve [--bind H] [--port N] [--idle SECS] [--metrics-port N]");
    eprint("                 [--authorized-keys FILE] [--name HOST[,HOST…]]");
    eprint("  rayrelay stun  [--bind H] [--port N]");
    eprint("  rayrelay probe [--server H] [--port N]");
    eprint("  rayrelay host  [--server H] [--port N] [--key FILE]");
    eprint("  rayrelay join CODE [--server H] [--port N]");
    eprint("  rayrelay keygen FILE [--comment TEXT]");
    eprint("");
    eprint(
        "  serve: TCP rendezvous (default port "
            + to_string(DEFAULT_PORT)
            + "); pairs pipe blindly, E2E crypto is the apps' job"
    );
    eprint("  authorized-keys: only these Ed25519 keys may HOST (re-read on SIGHUP)");
    eprint("  name:  the names clients dial this relay by; AUTH must be signed for one");
    eprint("  keygen: a private key for host --key, and the line for the keys file");
    eprint(
        "  stun:  UDP observed-address responder (default port "
            + to_string(DEFAULT_STUN_PORT)
            + "); separate process by design"
    );
    eprint(
        "  idle:  per-direction inactivity limit while relaying, 0 = none (default "
            + to_string(DEFAULT_IDLE_SECS)
            + ")"
    );
}

fn flag_value(av: [string], name: string) -> Option<string> {
    var i = 0;
    while (i + 1 < av.len()) {
        if (av[i] == name) {
            return Option.Some(av[i + 1]);
        }
        i = i + 1;
    }
    Option.None
}

fn flag_int(av: [string], name: string, fallback: int) -> int {
    match (flag_value(av, name)) {
        Option.Some(s) => parse_int(s).unwrap_or(fallback),
        Option.None => fallback,
    }
}

fn flag_str(av: [string], name: string, fallback: string) -> string {
    flag_value(av, name).unwrap_or(fallback)
}

fn names_from(raw: string) -> [string] {
    var out: [string] = [];
    for n in raw.split(",") {
        if (n.trim().len() > 0) {
            out.push(n.trim().to_lower());
        }
    }
    out
}

/// Runs until SIGTERM/SIGINT; SIGHUP re-reads the authorized keys.
fn serve_until_signal(server: relay.Server, opts: relay.ServeOpts) -> int {
    let lg = logger("rayrelay");
    emit(field_int(info(lg, "relay listening"), "port", server.port));
    if (opts.keys_path.len() > 0) {
        emit(field(info(lg, "hosting needs an authorized key"), "keys", opts.keys_path));
        if (opts.names.len() == 0) {
            emit(warn(lg, "no --name: AUTH signatures are not bound to this relay's name"));
        }
        process.listen_signal(process.SIGHUP);
    }
    while (true) {
        match (recv(signals())) {
            Option.Some(sig) => {
                if (sig == process.SIGHUP) {
                    match (relay.reload(server)) {
                        Result.Ok(n) => emit(field_int(info(lg, "keys reloaded"), "keys", n)),
                        Result.Err(e) => emit(field(warn(lg, "keys not reloaded"), "error", e)),
                    }
                    continue;
                }
                emit(field_int(info(lg, "shutting down"), "signal", sig));
                break;
            },
            Option.None => break,
        }
    }
    0
}

fn keygen(av: [string]) -> int {
    if (av.len() < 2 || av[1].starts_with("--")) {
        eprint("rayrelay: keygen needs a file");
        return 1;
    }
    match (auth.create_private(av[1])) {
        Result.Err(e) => {
            eprint("rayrelay: " + e);
            1
        },
        Result.Ok(public) => {
            eprint("private key: " + av[1] + " (keep it secret)");
            eprint("add this line to the relay's authorized keys:");
            print(auth.public_line(public, flag_str(av, "--comment", "rayrelay-key")));
            0
        },
    }
}

fn main() -> int {
    let av = args();
    if (av.len() < 1) {
        usage();
        return 1;
    }
    let cmd = av[0];
    if (cmd == "serve") {
        let opts = relay.ServeOpts {
            bind: flag_str(av, "--bind", "0.0.0.0"),
            port: flag_int(av, "--port", DEFAULT_PORT),
            idle_ms: flag_int(av, "--idle", DEFAULT_IDLE_SECS) * 1000,
            metrics_port: flag_int(av, "--metrics-port", 0),
            keys_path: flag_str(av, "--authorized-keys", ""),
            names: names_from(flag_str(av, "--name", ""))
        };
        match (relay.start(opts)) {
            Result.Err(e) => {
                eprint("rayrelay: " + e);
                1
            },
            Result.Ok(server) => serve_until_signal(server, opts),
        }
    } else if (cmd == "stun") {
        stun.serve_stun(
            flag_str(av, "--bind", "0.0.0.0"),
            flag_int(av, "--port", DEFAULT_STUN_PORT)
        )
    } else if (cmd == "probe") {
        let server = flag_str(av, "--server", "127.0.0.1");
        match (stun.probe(server, flag_int(av, "--port", DEFAULT_STUN_PORT))) {
            Result.Ok(reply) => {
                print(reply);
                0
            },
            Result.Err(e) => {
                eprint("rayrelay: " + e);
                1
            },
        }
    } else if (cmd == "host") {
        client.run_host(
            flag_str(av, "--server", "127.0.0.1"),
            flag_int(av, "--port", DEFAULT_PORT),
            flag_str(av, "--key", "")
        )
    } else if (cmd == "join") {
        if (av.len() < 2 || av[1].starts_with("--")) {
            eprint("rayrelay: join needs a code");
            usage();
            return 1;
        }
        client.run_join(
            flag_str(av, "--server", "127.0.0.1"),
            flag_int(av, "--port", DEFAULT_PORT),
            av[1]
        )
    } else if (cmd == "keygen") {
        keygen(av)
    } else if (cmd == "--help" || cmd == "-h" || cmd == "help") {
        usage();
        0
    } else {
        eprint("rayrelay: unknown command: " + cmd);
        usage();
        1
    }
}
