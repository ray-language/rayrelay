// rayrelay — test clients: netcat through the relay.
//
// `rayrelay host` prints a code and pipes stdin/stdout through the relay;
// `rayrelay join <code>` connects to it. Handy for manual testing and as the
// reference for wiring takeit/msg to a relay.
import std/net;
import std/io;
import std/crypto;
import std/hex;
import lineio;
import auth;

/// HOST, answering the relay's challenge when it sends one (`seed` = the private key;
/// None on an open relay). `server` is the name this client dialed: the signature is
/// bound to it. Returns the code.
pub fn host_handshake(
    c: lineio.LineConn,
    server: string,
    seed: Option<bytes>
) -> Result<string, string> {
    let s = match (seed) {
        Option.None => {
            lineio.write_line(c, "HOST")?;
            return expect_line(c, "CODE ");
        },
        Option.Some(s) => s,
    };
    let public = match (crypto.ed25519_public_key(s)) {
        Option.Some(p) => p,
        Option.None => {
            return Result.Err("the private key is not 32 bytes");
        },
    };
    let id = auth.key_id(public);
    lineio.write_line(c, "HOST " + id)?;
    let line = lineio.read_line(c, 256)?.trim();
    if (line.starts_with("CODE ")) {
        return Result.Ok(line.substring(5, line.len()));
    }
    if (!line.starts_with("CHALLENGE ")) {
        return Result.Err(refusal(line));
    }
    let nonce = match (hex.hex_decode(line.substring(10, line.len()))) {
        Result.Ok(n) => n,
        Result.Err(_) => {
            return Result.Err("malformed challenge");
        },
    };
    let sig = auth.sign(s, server, id, nonce)?;
    lineio.write_line(c, "AUTH " + server.to_lower() + " " + hex.hex_encode(sig))?;
    expect_line(c, "CODE ")
}

fn refusal(line: string) -> string {
    if (line.starts_with("ERR ")) {
        "server: " + line.substring(4, line.len())
    } else {
        "unexpected reply: " + line
    }
}

pub fn run_host(server: string, port: int, key_path: string) -> int {
    let seed = if (key_path.len() == 0) {
        Option.None
    } else {
        match (auth.load_private(key_path)) {
            Result.Ok(s) => Option.Some(s),
            Result.Err(e) => {
                eprint("rayrelay: " + e);
                return 1;
            },
        }
    };
    match (net.tcp_connect(server, port)) {
        Result.Err(e) => {
            eprint("rayrelay: connect failed: " + e);
            1
        },
        Result.Ok(h) => {
            let c = lineio.from_handle(h);
            let code = match (host_handshake(c, server, seed)) {
                Result.Ok(rest) => rest,
                Result.Err(e) => {
                    eprint("rayrelay: " + e);
                    close(h);
                    return 1;
                },
            };
            eprint("code: " + code);
            eprint(
                "peer should run: rayrelay join "
                    + code
                    + " --server "
                    + server
                    + " --port "
                    + to_string(port)
            );
            match (expect_line(c, "PEER")) {
                Result.Ok(rest) => { },
                Result.Err(e) => {
                    eprint("rayrelay: " + e);
                    close(h);
                    return 1;
                },
            }
            eprint("peer connected");
            pipe_stdio(c)
        },
    }
}

pub fn run_join(server: string, port: int, code: string) -> int {
    match (net.tcp_connect(server, port)) {
        Result.Err(e) => {
            eprint("rayrelay: connect failed: " + e);
            1
        },
        Result.Ok(h) => {
            let c = lineio.from_handle(h);
            if (!write_or_close(c, "JOIN " + code)) {
                return 1;
            }
            match (expect_line(c, "OK")) {
                Result.Ok(rest) => { },
                Result.Err(e) => {
                    eprint("rayrelay: " + e);
                    close(h);
                    return 1;
                },
            }
            eprint("connected");
            pipe_stdio(c)
        },
    }
}

fn write_or_close(c: lineio.LineConn, line: string) -> bool {
    match (lineio.write_line(c, line)) {
        Result.Ok(n) => true,
        Result.Err(e) => {
            eprint("rayrelay: write failed: " + e);
            close(c.h);
            false
        },
    }
}

// Reads one control line and checks the expected prefix ("PEER" and "OK" are
// exact; "CODE " returns the remainder). An ERR line surfaces its reason.
fn expect_line(c: lineio.LineConn, want: string) -> Result<string, string> {
    let line = lineio.read_line(c, 256)?;
    let t = line.trim();
    if (t == want.trim() && !want.ends_with(" ")) {
        return Result.Ok("");
    }
    if (want.ends_with(" ") && t.starts_with(want)) {
        return Result.Ok(t.substring(want.len(), t.len()));
    }
    Result.Err(refusal(t))
}

// Reader fibers feed two channels and MAIN owns every decision (select +
// recv). On stdin EOF the socket is half-closed (shutdown SHUT_WR): the peer
// sees EOF through the relay while this side keeps printing whatever it still
// sends, until the peer closes too — the classic netcat idiom.
fn pipe_stdio(c: lineio.LineConn) -> int {
    let h = c.h;
    net.set_nodelay(h, true);
    net.set_keepalive(h, true);
    let stdin_ch: Channel<bytes> = Channel.bounded(8);
    let sock_ch: Channel<bytes> = Channel.bounded(8);
    spawn(fn() {
        while (true) {
            match (io.read(65536)) {
                Option.Some(chunk) => send(stdin_ch, chunk),
                Option.None => break,
            }
        }
        close(stdin_ch);
    });
    spawn(fn() {
        while (true) {
            match (net.socket_read_bytes(h)) {
                Result.Ok(chunk) => {
                    if (chunk.len() == 0) {
                        break;
                    }
                    send(sock_ch, chunk);
                },
                Result.Err(e) => break,
            }
        }
        close(sock_ch);
    });
    let early = lineio.take_leftover(c);
    if (early.len() > 0) {
        io.write_bytes(early);
        io.flush();
    }
    while (true) {
        if (select([stdin_ch, sock_ch]) == 1) {
            if (!drain_one(sock_ch)) {
                return 0;
            }
            continue;
        }
        match (recv(stdin_ch)) {
            Option.Some(chunk) => {
                if let Result.Err(e) = net.socket_write_bytes(h, chunk) {
                    return 0;
                }
            },
            Option.None => {
                net.shutdown_write(h);
                break;
            },
        }
    }
    while (drain_one(sock_ch)) { }
    0
}

// One socket chunk to stdout; false when the stream (or the grace) ended.
fn drain_one(sock_ch: Channel<bytes>) -> bool {
    match (recv(sock_ch)) {
        Option.Some(chunk) => {
            io.write_bytes(chunk);
            io.flush();
            true
        },
        Option.None => false,
    }
}
