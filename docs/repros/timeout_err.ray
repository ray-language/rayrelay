import std/net;

fn main() -> int {
    let listener = match (net.tcp_listen("127.0.0.1", 0)) {
        Result.Ok(l) => l,
        Result.Err(e) => { eprint(e); return 1; },
    };
    let port = net.local_port(listener);
    spawn(fn() { net.tcp_connect("127.0.0.1", port); });
    let server = match (net.tcp_accept(listener)) {
        Result.Ok(h) => h,
        Result.Err(e) => { eprint(e); return 1; },
    };
    net.set_read_timeout(server, 300);
    match (net.socket_read_bytes(server)) {
        Result.Ok(b) => print("Ok len " + to_string(b.len())),
        Result.Err(e) => print("timeout err: [" + e + "]"),
    }
    0
}
