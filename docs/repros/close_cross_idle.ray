// Cross-fiber close while the socket is IDLE (nobody parked reading it).
import std/net;
import std/time;

fn main() -> int {
    let listener = match (net.tcp_listen("127.0.0.1", 0)) {
        Result.Ok(l) => l,
        Result.Err(e) => { eprint(e); return 1; },
    };
    let port = net.local_port(listener);
    let ready: Channel<int> = Channel.bounded(1);
    spawn(fn() {
        match (net.tcp_connect("127.0.0.1", port)) {
            Result.Ok(peer) => {
                send(ready, peer);
            },
            Result.Err(e) => panic(e),
        }
    });
    let server = match (net.tcp_accept(listener)) {
        Result.Ok(h) => h,
        Result.Err(e) => { eprint(e); return 1; },
    };
    let peer = match (recv(ready)) {
        Option.Some(p) => p,
        Option.None => panic("no peer"),
    };
    let done: Channel<int> = Channel.bounded(1);
    spawn(fn() {
        close(server);
        send(done, 0);
    });
    recv(done);
    time.sleep(100);
    net.set_read_timeout(peer, 500);
    match (net.socket_read_bytes(peer)) {
        Result.Ok(b) => {
            if (b.len() == 0) {
                print("idle cross-fiber close: FIN arrived (close worked)");
            } else {
                print("unexpected data");
            }
        },
        Result.Err(e) => print("idle cross-fiber close: peer read Err [" + e + "] (close did NOT propagate)"),
    }
    match (net.socket_read_bytes(server)) {
        Result.Ok(b) => print("closed handle read: Ok " + to_string(b.len())),
        Result.Err(e) => print("closed handle read: Err [" + e + "]"),
    }
    0
}
